# ---------------------------------------------------------------------------
# Server-only secrets. Never prefix these with NEXT_PUBLIC_ — that would inline
# them into the browser bundle. See docs/google-sheets-setup.md.
# ---------------------------------------------------------------------------

# Apps Script web-app /exec URL that appends rows to the leads spreadsheet.
GOOGLE_SHEETS_WEBHOOK_URL=

# Shared secret the Apps Script checks before writing a row.
GOOGLE_SHEETS_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# Public configuration. Safe to expose; used for canonical URLs and hreflang.
# ---------------------------------------------------------------------------

# Where this landing page is deployed, no trailing slash.
# e.g. https://retail.jaleedwater.com  or  https://jaleedwater.com
NEXT_PUBLIC_SITE_URL=https://retail.jaleedwater.com

# Path the page is served from. Use "/" when deploying to its own subdomain.
NEXT_PUBLIC_LANDING_PATH=/retail-supply

# Value written to the spreadsheet's Source column.
NEXT_PUBLIC_LEAD_SOURCE=retail-supply-landing
